# ─── Ariba SOC Unified Stack ───────────────────────────────
# Copy this file to .env and fill in real values before starting the stack.
# Usage: cp .env.example .env && vim .env

# ─── Wazuh Stack ───────────────────────────────────────────
WAZUH_INDEXER_ADMIN_USERNAME=admin
WAZUH_INDEXER_ADMIN_PASSWORD=CHANGE_ME_INDEXER_PASSWORD
WAZUH_API_USERNAME=wazuh-wui
WAZUH_API_PASSWORD=CHANGE_ME_MANAGER_API_PASSWORD
WAZUH_DASHBOARD_USERNAME=kibanaserver
WAZUH_DASHBOARD_PASSWORD=CHANGE_ME_DASHBOARD_PASSWORD

# ─── Ariba SOC (Django) ────────────────────────────────────
# Generate secrets: python3 -c "import secrets; print(secrets.token_urlsafe(50))"
DJANGO_SECRET_KEY=CHANGE_ME_RANDOM_50_CHARS
DJANGO_CRYPTOGRAPHY_KEY=CHANGE_ME_RANDOM_50_CHARS
DJANGO_DEBUG=True
DJANGO_ALLOWED_HOSTS=*
DJANGO_RUN_MODE=development
DJANGO_USE_HTTPS=False
DJANGO_CSRF_TRUSTED_ORIGINS=

# ─── Database ──────────────────────────────────────────────
DATABASE_ENGINE=django.db.backends.postgresql
DATABASE_NAME=ariba_soc
DATABASE_USER=ariba_soc
DATABASE_PASSWORD=CHANGE_ME_DB_PASSWORD
DATABASE_HOST=db
DATABASE_PORT=5432

# ─── Wazuh API ─────────────────────────────────────────────
WAZUH_API_URL=https://wazuh.manager:55000
WAZUH_API_USERNAME=wazuh-wui
WAZUH_API_PASSWORD=CHANGE_ME_MANAGER_API_PASSWORD
WAZUH_VERIFY_SSL=False
WAZUH_API_TIMEOUT=30

# ─── Wazuh Indexer ─────────────────────────────────────────
WAZUH_INDEXER_URL=https://wazuh.indexer:9200
WAZUH_INDEXER_USERNAME=admin
WAZUH_INDEXER_PASSWORD=CHANGE_ME_INDEXER_PASSWORD
WAZUH_INDEXER_VERIFY_SSL=False
WAZUH_INDEXER_INDEX_PATTERN=wazuh-alerts-*

# ─── Django Admin ───────────────────────────────────────────
DJANGO_ADMIN_USERNAME=admin
DJANGO_ADMIN_EMAIL=admin@example.com
DJANGO_ADMIN_PASSWORD=CHANGE_ME_ADMIN_PASSWORD

# ─── Redis ─────────────────────────────────────────────────
REDIS_URL=redis://redis:6379/1

# ─── Scheduler ─────────────────────────────────────────────
WAZUH_SYNC_INTERVAL_SECONDS=300
CLEANUP_INTERVAL_SECONDS=86400
REPORTS_INTERVAL_SECONDS=3600

# ─── Email ─────────────────────────────────────────────────
EMAIL_HOST=smtp.example.com
EMAIL_PORT=587
EMAIL_HOST_USER=notifications@example.com
EMAIL_HOST_PASSWORD=CHANGE_ME_SMTP_PASSWORD
EMAIL_USE_TLS=True
DEFAULT_FROM_EMAIL=noreply@example.com

# ─── HTTP Port ─────────────────────────────────────────────
HTTP_PORT=8080
