# Django
DJANGO_SECRET_KEY=change-this-to-a-secure-random-key
DJANGO_DEBUG=True
DJANGO_ALLOWED_HOSTS=*

# Database (PostgreSQL)
DATABASE_ENGINE=django.db.backends.postgresql
DATABASE_NAME=ariba_soc
DATABASE_USER=ariba_soc
DATABASE_PASSWORD=ariba_soc
DATABASE_HOST=localhost
DATABASE_PORT=5432

# Wazuh API
WAZUH_API_URL=https://localhost:55000
WAZUH_API_USERNAME=wazuh-user
WAZUH_API_PASSWORD=wazuh-password
WAZUH_VERIFY_SSL=False
WAZUH_API_TIMEOUT=30
