# Django Core
DJANGO_SECRET_KEY=change-this-to-a-secure-random-key
DJANGO_DEBUG=True
DJANGO_ALLOWED_HOSTS=*
DJANGO_RUN_MODE=development

# Database (PostgreSQL)
DATABASE_ENGINE=django.db.backends.postgresql
DATABASE_NAME=ariba_soc
DATABASE_USER=ariba_soc
DATABASE_PASSWORD=ariba_soc
DATABASE_HOST=localhost
DATABASE_PORT=5432

# For SQLite fallback (dev only):
# DATABASE_ENGINE=django.db.backends.sqlite3

# Wazuh Manager API (used by app default fallback + fix_db.py/test_wazuh_api.py)
WAZUH_API_URL=https://localhost:55000
WAZUH_API_USERNAME=wazuh-user
WAZUH_API_PASSWORD=wazuh-password
WAZUH_VERIFY_SSL=False
WAZUH_API_TIMEOUT=30

# Wazuh Indexer API (used only by fix_db.py/seed_wazuh_config.py one-off scripts;
# the running app reads its Indexer config from the DB via the Settings UI)
WAZUH_INDEXER_URL=https://localhost:9200
WAZUH_INDEXER_USERNAME=admin
WAZUH_INDEXER_PASSWORD=indexer-password
WAZUH_INDEXER_VERIFY_SSL=False
WAZUH_INDEXER_INDEX_PATTERN=wazuh-alerts-*

# Django admin bootstrap (used only by create_admin.py/get_creds.py one-off scripts)
DJANGO_ADMIN_USERNAME=admin
DJANGO_ADMIN_EMAIL=admin@example.com
DJANGO_ADMIN_PASSWORD=change-this-strong-password

# Redis (for caching)
REDIS_URL=redis://localhost:6379/1

# Scheduler (docker-compose scheduler service only)
WAZUH_SYNC_INTERVAL_SECONDS=300
CLEANUP_INTERVAL_SECONDS=86400
REPORTS_INTERVAL_SECONDS=3600

# Email (for notifications)
EMAIL_HOST=smtp.example.com
EMAIL_PORT=587
EMAIL_HOST_USER=notifications@example.com
EMAIL_HOST_PASSWORD=smtp-password
EMAIL_USE_TLS=True
DEFAULT_FROM_EMAIL=noreply@example.com
