# ==============================================================================
# ARIBA SOC & WAZUH UNIFIED STACK - PRODUCTION ENVIRONMENT CONFIGURATION
# ==============================================================================
# Usage:
#   cp .env.example .env
#   chmod 600 .env
#   nano .env
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. WAZUH STACK CREDENTIALS
# ------------------------------------------------------------------------------
# Default admin user for Wazuh Indexer (OpenSearch)
WAZUH_INDEXER_ADMIN_USERNAME=admin
# NOTE: If changed, must match bcrypt hash in config/wazuh_indexer/internal_users.yml
WAZUH_INDEXER_ADMIN_PASSWORD=Secret_Wazuh_Indexer_Pass123!

# Wazuh Manager API credentials
WAZUH_API_USERNAME=wazuh-wui
WAZUH_API_PASSWORD=Secret_Wazuh_API_Pass123!

# Wazuh Dashboard credentials (for OpenSearch Dashboards backend)
WAZUH_DASHBOARD_USERNAME=kibanaserver
# NOTE: If changed, must match bcrypt hash in config/wazuh_indexer/internal_users.yml
WAZUH_DASHBOARD_PASSWORD=Secret_Wazuh_Dashboard_Pass123!

# ------------------------------------------------------------------------------
# 2. ARIBA SOC (DJANGO SETTINGS)
# ------------------------------------------------------------------------------
# Generate strong keys with: python3 -c "import secrets; print(secrets.token_urlsafe(50))"
DJANGO_SECRET_KEY=change-this-to-a-very-secure-random-string-50-characters-min
DJANGO_CRYPTOGRAPHY_KEY=change-this-to-another-secure-random-string-50-chars

DJANGO_DEBUG=False
DJANGO_ALLOWED_HOSTS=*
DJANGO_RUN_MODE=production
DJANGO_USE_HTTPS=False
# If using HTTPS / Domain, set: DJANGO_CSRF_TRUSTED_ORIGINS=https://soc.yourdomain.com
DJANGO_CSRF_TRUSTED_ORIGINS=

# Default initial Django superuser credentials (auto-created if specified)
DJANGO_ADMIN_USERNAME=admin
DJANGO_ADMIN_EMAIL=admin@example.com
DJANGO_ADMIN_PASSWORD=Admin_SOC_Pass123!

# ------------------------------------------------------------------------------
# 3. POSTGRES DATABASE
# ------------------------------------------------------------------------------
DATABASE_ENGINE=django.db.backends.postgresql
DATABASE_NAME=ariba_soc
DATABASE_USER=ariba_soc
DATABASE_PASSWORD=Secret_DB_Password_AribaSoc_123!
DATABASE_HOST=db
DATABASE_PORT=5432

# ------------------------------------------------------------------------------
# 4. REDIS CACHE & CELERY/CHANNELS
# ------------------------------------------------------------------------------
REDIS_URL=redis://redis:6379/1

# ------------------------------------------------------------------------------
# 5. WAZUH INTEGRATION SETTINGS FOR DJANGO
# ------------------------------------------------------------------------------
WAZUH_API_URL=https://wazuh.manager:55000
WAZUH_VERIFY_SSL=False
WAZUH_API_TIMEOUT=30

WAZUH_INDEXER_URL=https://wazuh.indexer:9200
WAZUH_INDEXER_USERNAME=admin
WAZUH_INDEXER_PASSWORD=Secret_Wazuh_Indexer_Pass123!
WAZUH_INDEXER_VERIFY_SSL=False
WAZUH_INDEXER_INDEX_PATTERN=wazuh-alerts-*

# ------------------------------------------------------------------------------
# 6. SCHEDULER & BACKGROUND TASKS
# ------------------------------------------------------------------------------
WAZUH_SYNC_INTERVAL_SECONDS=300
CLEANUP_INTERVAL_SECONDS=86400
REPORTS_INTERVAL_SECONDS=3600

# ------------------------------------------------------------------------------
# 7. EMAIL NOTIFICATIONS (OPTIONAL)
# ------------------------------------------------------------------------------
EMAIL_HOST=smtp.example.com
EMAIL_PORT=587
EMAIL_HOST_USER=notifications@example.com
EMAIL_HOST_PASSWORD=
EMAIL_USE_TLS=True
DEFAULT_FROM_EMAIL=noreply@example.com

# ------------------------------------------------------------------------------
# 8. NETWORK & PORTS
# ------------------------------------------------------------------------------
# Ariba SOC Web UI Port (default: 80)
HTTP_PORT=80
